# ── WhatsApp Campaign Studio — environment variables ───────────────────────
# Copy to `.env` for local dev. On Railway, set these under the service's
# "Variables" tab (do NOT commit real secrets).

# REQUIRED in production. The single password that gates the whole app.
ADMIN_PASSWORD=change-me-to-something-strong

# Keeps everyone logged in across restarts. Generate one:
#   node -e "console.log(require('crypto').randomBytes(32).toString('hex'))"
# If you leave it blank, a random one is used (users log out on each restart).
SESSION_SECRET=

# Where persistent data (DB, WhatsApp session, uploads) is stored.
# On Railway, attach a Volume and set its mount path here (e.g. /data).
DATA_DIR=/data

# Port is provided by Railway automatically; 3000 locally.
# PORT=3000

# Optional tuning (milliseconds / counts).
# DEFAULT_MIN_DELAY_MS=4000
# DEFAULT_MAX_DELAY_MS=9000
# DEFAULT_DAILY_CAP=200
# DEFAULT_COUNTRY_CODE=91
# MAX_ATTACH_MB=64

# Set to 1 to run the simulated engine (no real WhatsApp) — handy for demos/tests.
# MOCK=0

# Only override if you manage your own Chromium (the Docker image sets this).
# PUPPETEER_EXECUTABLE_PATH=/usr/bin/chromium
